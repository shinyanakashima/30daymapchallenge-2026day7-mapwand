{
  "name": "mapwand",
  "private": true,
  "version": "0.1.0",
  "description": "MapWand: M5StickC Plus + Hat Mini EncoderC で回して押して地図をつくる道具",
  "type": "module",
  "scripts": {
    "data:fetch": "bash data/scripts/fetch_raw.sh",
    "data:density": "python3 data/scripts/build_density.py",
    "data:boundaries": "node --max-old-space-size=8192 data/scripts/build_boundaries.mjs",
    "data:check": "node data/scripts/check_join.mjs",
    "data:build": "npm run data:density && npm run data:boundaries && npm run data:check",
    "protocol:gen": "node protocol/generate.mjs"
  },
  "devDependencies": {
    "mapshaper": "0.7.101"
  }
}
